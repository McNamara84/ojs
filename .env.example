# Vorlage für .env – scripts/setup-dev.ps1 erzeugt daraus .env mit zufälligen Passwörtern.

COMPOSE_PROJECT_NAME=ojs

# Images
OJS_IMAGE_TAG=3_5_0-5
MARIADB_IMAGE=mariadb:11.8
# Minor-Tag: erhält Patch-Releases automatisch beim Pull
MAILPIT_IMAGE=axllent/mailpit:v1.31

# Host-Ports (nur an 127.0.0.1 gebunden).
# Bei Änderung von OJS_HTTP_PORT auch OJS_BASE_URL und base_url in docker/ojs/config.inc.php anpassen.
OJS_HTTP_PORT=8081
MAILPIT_HTTP_PORT=8025
OJS_BASE_URL=http://localhost:8081

# Datenbank
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

TZ=Europe/Berlin

# Xdebug: off | debug | develop,debug | profile
# Änderung wirksam mit: docker compose -f docker-compose.dev.yml up -d ojs-app
XDEBUG_MODE=off
