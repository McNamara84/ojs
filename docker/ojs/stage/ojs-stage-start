#!/bin/sh
# Entrypoint fuer ojs-app (Stage): Config setzen -> ggf. DB-Upgrade -> Apache.
set -eu

CONFIG=/var/www/config/config.inc.php

php /usr/local/lib/ojs/ojs-configure.php --config="$CONFIG"

if grep -Eq '^[[:space:]]*installed[[:space:]]*=[[:space:]]*On' "$CONFIG"; then
    if [ "${OJS_RUN_UPGRADE:-1}" = "1" ]; then
        # Analog ERNIE_RUN_MIGRATIONS: nur upgraden, wenn der Code neuer ist als die DB.
        # Rein lokaler Vergleich, ohne Abruf der Versionsdatei von pkp.sfu.ca.
        if ! versions="$(php /usr/local/lib/ojs/ojs-version-check.php)"; then
            echo "[ojs-stage-start] FEHLER: Versionsvergleich fehlgeschlagen." >&2
            exit 1
        fi

        code_version="${versions% *}"
        db_version="${versions#* }"

        if [ "$code_version" != "$db_version" ]; then
            echo "[ojs-stage-start] Upgrade der Datenbank von $db_version auf $code_version ..."
            php tools/upgrade.php upgrade
        else
            echo "[ojs-stage-start] Datenbank ist aktuell ($db_version)."
        fi
    else
        echo "[ojs-stage-start] OJS_RUN_UPGRADE=0 - automatisches Upgrade uebersprungen."
    fi
fi

exec apache2-foreground
